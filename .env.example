# ==============================================================================
# Portfolio V2 — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site URL (Mandatory for Canonical SEO, Open Graph & Sitemap generation)
# ------------------------------------------------------------------------------
# In development: http://localhost:3000
# In production: https://sagarramani.dev (or verified custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Resend Email Delivery (/api/contact)
# ------------------------------------------------------------------------------
# Mandatory for live email delivery from the contact form.
# If omitted, /api/contact returns HTTP 503 (service unconfigured) gracefully.
# Never expose these server-side variables to client code.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# ------------------------------------------------------------------------------
# 3. Cloudflare Turnstile Spam & Bot Protection (Optional)
# ------------------------------------------------------------------------------
# If omitted, contact form relies on honeypot + rate limiting.
# If configured, requests to /api/contact require valid turnstile verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 4. Distributed Rate Limiting via Upstash Redis REST (Optional)
# ------------------------------------------------------------------------------
# If configured, /api/contact uses durable distributed rate limiting across
# serverless instances. If omitted, falls back gracefully to in-memory sliding window.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
